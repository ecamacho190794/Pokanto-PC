+static const char* display_fullscreen_label(const LauncherModel* m) {
+    if (!spanish_fixed_rom_ui(m)) return launcher_model_fullscreen_label(m);
+    static const char* const labels[] = {
+        POKANTO_TEXT_FULLSCREEN_OFF, POKANTO_TEXT_FULLSCREEN_BORDERLESS,
+        POKANTO_TEXT_FULLSCREEN_EXCLUSIVE
+    };
+    int index = m->s.fullscreen < 0 ? 0 : (m->s.fullscreen > 2 ? 2 : m->s.fullscreen);
+    return labels[index];
