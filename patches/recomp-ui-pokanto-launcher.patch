+        POKANTO_TEXT_SCREEN_AMBER, POKANTO_TEXT_SCREEN_SGB,
+        POKANTO_TEXT_SCREEN_SGB_NO_BORDER
+    };
+    int index = m->s.screen_kind < 0 ? 0 : (m->s.screen_kind > 6 ? 6 : m->s.screen_kind);
+    return labels[index];
+}
