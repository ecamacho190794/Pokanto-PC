+++ b/ram/wram.asm
@@ -417 +417,5 @@ wBoostExpByExpAll:: db
-	ds 59
+; Host-controlled horizontal radius for overworld object visibility. This uses
+; one byte from the following reserved gap, preserving all later WRAM addresses.
+wGBRecompViewExtraTiles:: db
+
+	ds 58
