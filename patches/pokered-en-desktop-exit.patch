diff --git a/home/start_menu.asm b/home/start_menu.asm
index 9504d536..ed01fc30 100644
--- a/home/start_menu.asm
+++ b/home/start_menu.asm
@@ -75,7 +75,28 @@ RedisplayStartMenu::
 	cp 5
 	jp z, StartMenu_Option
 
-; EXIT falls through to here
+; EXIT closes the desktop game after offering to save.
+	jp StartMenu_Quit
+
+StartMenu_Quit:
+	ld hl, StartMenu_QuitPromptText
+	call PrintText
+	call YesNoChoice
+	ld a, [wCurrentMenuItem] ; 0 = yes, 1 = no
+	and a
+	jr nz, .quit
+	farcall SaveGameData
+.quit
+	ld a, $50 ; 'P'
+	ld [$FF7E], a
+	ld a, $4B ; 'K'
+	ld [$FF7F], a
+	jp CloseStartMenu
+
+StartMenu_QuitPromptText:
+	text_far _WouldYouLikeToSaveText
+	text_end
+
 CloseStartMenu::
 	call Joypad
 	ldh a, [hJoyPressed]
