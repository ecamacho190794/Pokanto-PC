diff --git a/home/start_menu.asm b/home/start_menu.asm
index 9504d53..46e29d9 100644
--- a/home/start_menu.asm
+++ b/home/start_menu.asm
@@ -78 +78,22 @@ RedisplayStartMenu::
-; EXIT falls through to here
+; Exit the running game instead of merely dismissing the start menu.
+jp StartMenu_Quit
+
+StartMenu_Quit:
+	ld hl, StartMenu_QuitPromptText
+	call PrintText
+	call YesNoChoice
+	ld a, [wCurrentMenuItem] ; 0 = Sí, 1 = No
+	and a
+	jr nz, .quit
+	farcall SaveGameData
+.quit
+	ld a, $50 ; 'P'
+	ld [$FF7E], a
+	ld a, $4B ; 'K'
+	ld [$FF7F], a
+	jp CloseStartMenu
+
+StartMenu_QuitPromptText:
+	text_far _WouldYouLikeToSaveText
+	text_end
+
