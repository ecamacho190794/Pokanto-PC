@@ -24,0 +29,37 @@ namespace {
+#if defined(__APPLE__)
+std::string desktop_glsl(const char* source, GLenum stage) {
+    std::string result = source ? source : "";
+    auto replace_all = [&result](const char* from, const char* to) {
+        size_t pos = 0;
+        const size_t from_len = strlen(from);
+        while ((pos = result.find(from, pos)) != std::string::npos) {
+            result.replace(pos, from_len, to);
+            pos += strlen(to);
+        }
+    };
+    replace_all("#version 100", "#version 150");
+    replace_all("precision mediump float;", "");
+    replace_all("precision highp float;", "");
+    replace_all("precision lowp float;", "");
+    replace_all("texture2D(", "texture(");
+    while (!result.empty() && (result.front() == '\n' || result.front() == '\r' ||
+                               result.front() == ' ' || result.front() == '\t')) {
+        result.erase(result.begin());
+    }
+    if (result.rfind("#version", 0) != 0) {
+        result.insert(0, "#version 150\n");
+    }
+    if (stage == GL_VERTEX_SHADER) {
+        replace_all("attribute ", "in ");
+        replace_all("varying ", "out ");
+    } else {
+        replace_all("varying ", "in ");
+        replace_all("gl_FragColor", "frag_color");
+        const size_t version_end = result.find('\n');
+        result.insert(version_end == std::string::npos ? 0 : version_end + 1,
+                      "out vec4 frag_color;\n");
+    }
+    return result;
+}
+#endif
+
