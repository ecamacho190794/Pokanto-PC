@@ -240,0 +294,16 @@ static int verify_rom(const char *path, char *resolved, size_t resolved_sz) {
+#if defined(GBRECOMP_APPLY_ROM_PATCH)
+    /* This language's recompiled code was generated from a patched image,
+     * while the launcher identifies the user's stock dump by CRC. Apply the
+     * shipped BPS before the runtime reads ROM-backed game data. */
+    if (s_patch_file[0]) {
+        char patched[512];
+        if (resolve_or_patch(path, patched, sizeof(patched))) {
+            int changed = strcmp(patched, path) != 0;
+            snprintf(resolved, resolved_sz, "%s", patched);
+            return changed ? 2 : 1;
+        }
+        fprintf(stderr, "[Launcher] ROM patch is missing or did not match this build.\n");
+        return 0;
+    }
+#endif
+
@@ -294,0 +364,93 @@ static int verify_rom(const char *path, char *resolved, size_t resolved_sz) {
+static int extension_matches(const char *filename, const char *extension) {
+    if (!filename || !extension || !extension[0]) return 0;
+    const char *dot = strrchr(filename, '.');
+    if (!dot) return 0;
+#ifdef _WIN32
+    return _stricmp(dot, extension) == 0;
+#else
+    return strcasecmp(dot, extension) == 0;
+#endif
+}
+
+static int rom_matches_accepted_crc(const char *path) {
+    int valid_count = 0;
+    const uint32_t *valid_list = game_get_valid_crcs(&valid_count);
+    if (!valid_list || valid_count <= 0) return 0;
+
+    long size = 0;
+    unsigned char *data = load_file(path, &size);
+    if (!data || size <= 0 || (unsigned long)size > 0xFFFFFFFFul) {
+        free(data);
+        return 0;
+    }
+    unsigned int crc = crc32_compute(data, (unsigned int)size);
+    free(data);
+    for (int i = 0; i < valid_count; ++i)
+        if (crc == valid_list[i]) return 1;
+    return 0;
+}
+
+static int consider_rom_candidate(const char *directory, const char *filename,
+                                  const char *extension, char *best_name,
+                                  size_t best_name_size, char *out_path,
+                                  size_t out_path_size) {
+    if (!filename || !filename[0] || !extension_matches(filename, extension))
+        return 0;
+    if (best_name[0] && strcmp(filename, best_name) >= 0) return 0;
+
+    char candidate[2048];
+    size_t dir_len = strlen(directory);
+    int needs_sep = dir_len > 0 && directory[dir_len - 1] != '/' &&
+                    directory[dir_len - 1] != '\\';
+    int n = snprintf(candidate, sizeof(candidate), "%s%s%s", directory,
+                     needs_sep ? "/" : "", filename);
+    if (n < 0 || (size_t)n >= sizeof(candidate) ||
+        !rom_matches_accepted_crc(candidate)) return 0;
+
+    if (strlen(candidate) >= out_path_size ||
+        strlen(filename) >= best_name_size) return 0;
+    strcpy(best_name, filename);
+    strcpy(out_path, candidate);
+    return 1;
+}
+
+int launcher_find_valid_rom_in_directory(const char *directory,
+                                         const char *extension,
+                                         char *out_path,
+                                         size_t out_path_size) {
+    if (!directory || !directory[0] || !extension || !out_path ||
+        out_path_size == 0) return 0;
+    out_path[0] = '\0';
+    char best_name[512] = {0};
+
+#ifdef _WIN32
+    char pattern[2048];
+    size_t dir_len = strlen(directory);
+    int needs_sep = dir_len > 0 && directory[dir_len - 1] != '/' &&
+                    directory[dir_len - 1] != '\\';
+    int n = snprintf(pattern, sizeof(pattern), "%s%s*", directory,
+                     needs_sep ? "\\" : "");
+    if (n < 0 || (size_t)n >= sizeof(pattern)) return 0;
+    WIN32_FIND_DATAA entry;
+    HANDLE find = FindFirstFileA(pattern, &entry);
+    if (find == INVALID_HANDLE_VALUE) return 0;
+    do {
+        if (!(entry.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY))
+            consider_rom_candidate(directory, entry.cFileName, extension,
+                                   best_name, sizeof(best_name), out_path,
+                                   out_path_size);
+    } while (FindNextFileA(find, &entry));
+    FindClose(find);
+#else
+    DIR *dir = opendir(directory);
+    if (!dir) return 0;
+    struct dirent *entry;
+    while ((entry = readdir(dir)) != NULL)
+        consider_rom_candidate(directory, entry->d_name, extension,
+                               best_name, sizeof(best_name), out_path,
+                               out_path_size);
+    closedir(dir);
+#endif
+    return out_path[0] != '\0';
+}
+
